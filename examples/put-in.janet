(put-in @[[0 1] @[]] @[1 0] 1) # -> @[[0 1] @[1]]
(put-in @[[0 1] @[2 3]] [1 0] 8) # -> @[[0 1] @[8 3]]
(put-in @[[0 1]] [1 0] 11) # -> @[[0 1] @{0 11}]

(put-in @{:a @{:b 2}} @[:a :b] 3) # -> @{:a @{:b 3}}
(put-in @{} [:a :b] 1) # -> @{:a @{:b 1}}
(put-in @{:x @[]} [:x 0] :treasure) # -> @{:x @[:treasure]}
