(pairs "abc") # -> @[[0 97] [1 98] [2 99]]
(pairs @"hi!") # -> @[[0 104] [1 105] [2 33]]
(pairs 'pair) # -> @[[0 112] [1 97] [2 105] [3 114]]
(pairs :jump) # -> @[[0 106] [1 117] [2 109] [3 112]]

(pairs [:ant :bee :cat]) # -> @[[0 :ant] [1 :bee] [2 :cat]]
(pairs @[1 1 2 3 5]) # -> @[[0 1] [1 1] [2 2] [3 3] [4 5]]

(sort (pairs {:a 1 :b 2})) # -> @[[:a 1] [:b 2]]
(sort (pairs @{0 :zero 1 :one})) # -> @[[0 :zero] [1 :one]]
